    },
    "This removes cached previews and temporary browsing data for %@. Downloaded comics remain available.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除 %@ 的快取預覽與暫存瀏覽資料。已下載的漫畫仍可使用。"
          }
        },
        "ja": {
          "stringUnit": {
