    "This WebDAV server does not support byte-range reads for direct thumbnails.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此 WebDAV 伺服器不支援直接縮圖所需的位元組範圍讀取。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このWebDAVサーバーは、サムネイルの直接取得に必要なバイト範囲読み込みに対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 WebDAV 服务器不支持直接读取缩略图所需的字节范围请求。"
          }
        }
      }
    },
    "This WebDAV server is using HTTP, and iOS blocked the connection. Switch the server to HTTPS or update the app to explicitly allow insecure HTTP for this endpoint.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此 WebDAV 伺服器使用 HTTP，因此 iOS 封鎖了連線。請將伺服器切換為 HTTPS，或更新 App 以明確允許此端點使用不安全的 HTTP。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このWebDAVサーバーはHTTPを使用しているため、iOSが接続をブロックしました。サーバーをHTTPSに切り替えるか、この接続先への安全でないHTTPを明示的に許可するようアプリを更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 WebDAV 服务器使用 HTTP，iOS 已阻止连接。请改用 HTTPS，或更新 App 配置以明确允许此地址使用不安全 HTTP。"
          }
        }
      }
