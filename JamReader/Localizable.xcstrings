          "stringUnit": {
            "state": "translated",
            "value": "此服务器在设备上已不可用。"
          }
        }
      }
    },
    "This source folder is read-only on this device. Reading and local metadata stay available, but importing files here is disabled.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此來源資料夾在此裝置上為唯讀。閱讀與本機中繼資料仍可使用，但無法將檔案匯入此處。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソースフォルダは、このデバイスで読み取り専用です。閲覧とローカルメタデータは引き続き利用できますが、ここにはファイルをインポートできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此源文件夹在设备上为只读。阅读和本地元数据仍可使用，但无法向此处导入文件。"
          }
        }
      }
    },
