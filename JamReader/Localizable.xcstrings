{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    "·": {
      "shouldTranslate": false
    },
    "\"%@\" is reserved for the built-in imported library.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」是內建匯入書庫的保留名稱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は内蔵のインポート済みライブラリ用に予約されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”已保留给内置的“已导入漫画”书库。"
          }
        }
      }
    },
    "(%lld)": {
      "shouldTranslate": false
    },
    "/Manga/Weekly": {
      "shouldTranslate": false
    },
    "/remote.php/dav/files/you/Comics": {
      "shouldTranslate": false
    },
    "/Weekly": {
      "shouldTranslate": false
    },
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@ · %lld folders · %lld comics": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$lld folders · %3$lld comics"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld 個資料夾 · %lld 本漫畫"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@・%lldフォルダ・%lld冊"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld 个文件夹 · %3$lld 本漫画"
          }
        }
      }
    },
    "%@ / %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ / %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@ browsing is planned but not wired into a live network client yet.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 瀏覽功能仍在規劃中，尚未連接實際的網路用戶端。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のブラウズ機能は予定されていますが、ネットワーククライアントとの連携はまだ実装されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 浏览功能已规划，但尚未连接到实际网络客户端。"
          }
        }
      }
    },
    "%@ could not be opened by MuPDF.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "MuPDF 無法開啟 %@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MuPDFで%@を開けませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MuPDF 无法打开 %1$@。"
          }
        }
      }
    },
    "%@ Downloads": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 下載項目"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のダウンロード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 下载内容"
          }
        }
      }
    },
    "%@ files are not supported.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援 %@ 檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ファイルには対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持 %1$@ 文件。"
          }
        }
      }
    },
    "%@ is already current on this device.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上的 %@ 已是最新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこのデバイスですでに最新です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在此设备上已是最新副本。"
          }
        }
      }
    },
    "%@ is already saved on this device and ready offline.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已儲存在此裝置，可供離線使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこのデバイスに保存済みで、オフラインで利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已保存在此设备上，可供离线阅读。"
          }
        }
      }
    },
    "%@ is currently read-only. Choose a writable local library or Imported Comics instead.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前為唯讀。請改選可寫入的本機書庫或「已匯入的漫畫」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は現在読み取り専用です。書き込み可能なローカルライブラリまたは「インポート済みコミック」を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 当前为只读。请选择可写的本地书库或“已导入漫画”。"
          }
        }
      }
    },
    "%@ is no longer available on the remote server.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端伺服器上已沒有 %@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はリモートサーバーで利用できなくなりました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程服务器上已找不到 %1$@。"
          }
        }
      }
    },
    "%@ is not a supported remote comic.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是支援的遠端漫畫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は対応しているリモートコミックではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不是支持的远程漫画。"
          }
        }
      }
    },
    "%@ is not configured for MuPDF rendering.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未設定使用 MuPDF 算繪。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はMuPDFでのレンダリング用に設定されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未配置为使用 MuPDF 渲染。"
          }
        }
      }
    },
    "%@ reading requires the MuPDF engine, which is not linked into this build.": {
      "localizations": {
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "閱讀 %@ 需要 MuPDF 引擎，但此版本並未連結該引擎。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を読むにはMuPDFエンジンが必要ですが、このビルドには組み込まれていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读 %1$@ 需要 MuPDF 引擎，但当前版本未包含该引擎。"
          }
        }
      }
    },
