    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JamReader needs permission to save the current comic page to your photo library."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の漫画ページを写真ライブラリに保存するため、JamReaderに写真へのアクセスを許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JamReader 需要访问您的照片图库，以保存当前漫画页面。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JamReader 需要取用您的照片圖庫，才能儲存目前的漫畫頁面。"
          }
